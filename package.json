{
  "name": "medical-uowa-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Stage 1 browser-based 3D clinical simulation with webcam hand tracking",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "validate-cases": "tsx packages/shared/scripts/validate-cases.ts content/cases",
    "dev:api": "npm run dev -w @sim/api",
    "dev:sim": "npm run dev -w @sim/sim"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^3.2.4"
  }
}
