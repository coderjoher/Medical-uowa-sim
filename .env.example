# Copy to .env on the university server and fill in.
SITE_ADDRESS=sim.uowa.local
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters
# Daily backup hour (UTC) and how many days of backups to keep (university retention policy).
BACKUP_HOUR=2
RETENTION_DAYS=90

# University sign-in through LDAP / Active Directory (optional). See docs/ldap.md.
# Group lists are separated by ";" because DNs contain commas.
LDAP_URL=
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=
LDAP_USER_BASE=
LDAP_USER_FILTER=
LDAP_ADMIN_GROUPS=
LDAP_INSTRUCTOR_GROUPS=
LDAP_AUTHOR_GROUPS=
LDAP_STUDENT_GROUPS=
LDAP_DEFAULT_ROLE=student
LDAP_STARTTLS=
LDAP_TLS_CA=
